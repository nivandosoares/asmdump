  "claim": "The bank-1 front-end helpers do not materialize a WRAM table at $1E80. The overlapping stores to $10/$11/$12 construct the long ROM pointer 1E:8000, and L00179B/L001662 then dereference rows from that table directly.",
  "rendering": {
    "render_dir": "tools/out/snes_frontend_pointer_table_controls_15_1b_renders",
    "render_scale": 4,
    "preview_note": "Rendered previews treat nonzero 4bpp pixels as grayscale, reinterpret descriptor x/y words as signed local offsets, and normalize the preview origin to the descriptor bounds before replaying the staged 4bpp OBJ blob."
  },
  "code_sites": [
    {
      "site": "01:BDF4",
      "selector_expr": "$0202 + 0x0008",
      "helper": "L001662",
      "expected_index_range": [
        8,
        10
      ]
    },
    {
      "site": "01:BE53",
      "selector_expr": "$1C7C + 0x000B",
      "helper": "L00179B",
      "expected_index_range": [
        11,
        14
      ]
    },
    {
