    "render_dir": "tools/out/snes_frontend_pointer_table_1e8000_renders",
    "render_scale": 4,
    "preview_note": "Rendered previews treat nonzero 4bpp pixels as grayscale, reinterpret descriptor x/y words as signed local offsets, and normalize the preview origin to the descriptor bounds before replaying the staged 4bpp OBJ blob."
  },
